{
  "name": "kioku-search",
  "displayName": "Kioku - Long-Term Memory for AI Coding Agents",
  "description": "Offline long-term memory for AI coding agents. Save lessons from completed tasks, recall them across chats, and retire outdated notes on Windows, macOS, and Linux.",
  "version": "0.8.1",
  "icon": "media/brain.png",
  "publisher": "ShunsukeF",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/furukawa658/kioku.git"
  },
  "homepage": "https://github.com/furukawa658/kioku#readme",
  "bugs": {
    "url": "https://github.com/furukawa658/kioku/issues"
  },
  "engines": {
    "vscode": "^1.102.0"
  },
  "main": "./extension.cjs",
  "extensionKind": ["ui"],
  "capabilities": {
    "untrustedWorkspaces": { "supported": false }
  },
  "categories": [
    "AI",
    "Chat",
    "Machine Learning"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "agent",
    "copilot",
    "claude",
    "claude-mem",
    "memory",
    "long-term memory",
    "context",
    "knowledge base",
    "lessons learned",
    "semantic search",
    "vector search",
    "embeddings",
    "onnx",
    "sqlite",
    "offline",
    "local",
    "日本語",
    "長期記憶"
  ],
  "activationEvents": [
    "onMcpServerDefinitionProvider:kioku.local"
  ],
  "scripts": {
    "build": "node --use-env-proxy build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check extension.cjs && node --check runtime.cjs && node --check mcp-provider.cjs && node --check copilot.cjs && node --check local-summary.cjs && node --check language.cjs && node --check media/sidebar.js"
  },
  "contributes": {
    "commands": [
      { "command": "kioku.injectInstructions", "title": "kioku: Inject Copilot Instructions" },
      { "command": "kioku.copyMcpConfig", "title": "kioku: Copy MCP Configuration" },
      { "command": "kioku.exportLessons", "title": "kioku: Export Project Lessons" },
      { "command": "kioku.importLessons", "title": "kioku: Import Project Lessons" }
    ],
    "mcpServerDefinitionProviders": [
      { "id": "kioku.local", "label": "kioku local memory" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kioku",
          "title": "kioku",
          "icon": "media/brain.svg"
        }
      ]
    },
    "views": {
      "kioku": [
        {
          "id": "kioku.search",
          "name": "Memory search",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "kioku",
      "properties": {
        "kioku.language": {
          "type": "string",
          "enum": ["en", "ja"],
          "enumDescriptions": ["English", "Japanese"],
          "default": "en",
          "scope": "application",
          "description": "Language of the kioku sidebar. English by default. It can also be switched from the sidebar."
        },
        "kioku.copilotEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "description": "OFF (default): local extractive script summaries with no AI credit consumption. ON: explicit, confirmed GitHub Copilot summaries, subject to your plan and model usage limits."
        },
        "kioku.workerUrl": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Local kioku worker URL. Leave empty to detect the existing kioku settings and installation port. Only HTTP loopback addresses are allowed."
        }
      }
    }
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.0",
    "lucide-static": "^1.71.0",
    "playwright": "^1.65.0"
  }
}
